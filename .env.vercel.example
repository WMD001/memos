# Vercel Deployment Environment Variables
# Copy these variables to your Vercel Project Settings > Environment Variables

# Server configuration
MEMOS_MODE=prod

# Database configuration
# Choose one of the following database drivers:

# Option 1: PostgreSQL (recommended)
MEMOS_DRIVER=postgres
MEMOS_DSN=postgres://user:password@host:port/database?sslmode=require

# Option 2: MySQL
# MEMOS_DRIVER=mysql
# MEMOS_DSN=user:password@tcp(host:port)/database?parseTime=true

# Option 3: SQLite (for testing, not recommended for production)
# MEMOS_DRIVER=sqlite
# MEMOS_DSN=file:/tmp/memos_prod.db

# Instance URL (auto-configured in most cases)
MEMOS_INSTANCE_URL=https://your-app.vercel.app

# Note: When deploying to Vercel, set these in the dashboard:
# - Go to your project in Vercel Dashboard
# - Navigate to Settings > Environment Variables
# - Add the above variables
# - Select appropriate environments (Production, Preview, Development)
